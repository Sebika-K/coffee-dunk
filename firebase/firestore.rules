// Firestore security rules for Coffee Dunk.
// These run on Google's servers and check EVERY request from the app.
// (The Flask backend uses the Admin SDK, which skips these rules.)
//
// To apply: Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
// Keep this file in git so every change to the rules is recorded.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isMe(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    // Am I ACCEPTED friends with this person? Looks up our one friendship
    // document - its id is our two ids sorted and joined, like pairId() in the app.
    function isFriendOf(otherId) {
      let me = request.auth.uid;
      let pair = me < otherId ? me + '_' + otherId : otherId + '_' + me;
      let path = /databases/$(database)/documents/friendships/$(pair);
      return exists(path) && get(path).data.status == 'accepted';
    }

    // --- Posts -------------------------------------------------------------
    match /uploads/{postId} {
      // FRIENDS ONLY: you can see your own posts and your friends' posts.
      allow read: if signedIn()
        && (isMe(resource.data.user_id) || isFriendOf(resource.data.user_id));

      // You can only create posts as YOURSELF
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;

      // Only the owner can edit, and only the DETAILS - never the owner,
      // the photo or the original date. (user / user_avatar are allowed so
      // your name and photo can be refreshed on old posts after you change them.)
      allow update: if isMe(resource.data.user_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'caption', 'rating', 'place_id', 'cafe_name',
             'drink', 'drink_custom', 'milk', 'temperature', 'notes',
             'source', 'recipe', 'edited_at', 'user', 'user_avatar'
           ]);

      // Only the owner can delete
      allow delete: if isMe(resource.data.user_id);
    }

    // --- Likes on a post (Phase 7.5) ---------------------------------------
    // uploads/<postId>/likes/<userId>  { created_at }
    // One per person per post (the document id is the liker's id).
    match /uploads/{postId}/likes/{userId} {
      // You can see your OWN like; the POSTER can see everyone's.
      // (No public like counts - that's the "gentle" part.)
      allow read: if isMe(userId)
        || (signedIn()
            && get(/databases/$(database)/documents/uploads/$(postId)).data.user_id == request.auth.uid);

      // You can only like as yourself, and the document may contain nothing else
      allow create: if isMe(userId)
        && request.resource.data.keys().hasOnly(['created_at']);

      // You can unlike (remove your own like), and the POSTER can remove
      // every like when they delete their post (so none are left behind).
      // In a batch, get() still sees the post as it was BEFORE the batch,
      // so this works even though the post is deleted in the same batch.
      allow delete: if isMe(userId)
        || (signedIn()
            && get(/databases/$(database)/documents/uploads/$(postId)).data.user_id == request.auth.uid);
    }

    // --- Public profiles (username, photo, bio) ----------------------------
    match /users/{userId} {
      // Logged-in users can see profiles (needed to find friends)
      allow read: if signedIn();
      // Only you can change your own profile
      allow write: if isMe(userId);
    }

    // --- Username claims (unique usernames) ------------------------------
    // usernames/<name in lowercase>  { uid, username }
    match /usernames/{name} {
      // Anyone may CHECK one name (signup asks before the account exists),
      // but nobody can list them all.
      allow get: if true;

      // Claim a free name: only for yourself, the id must be the lowercase
      // name, and nothing else in the document.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name == request.resource.data.username.lower()
        && request.resource.data.keys().hasOnly(['uid', 'username']);

      // Your OWN claim: change its capitals (Sam -> sam) or let it go.
      // Nobody can take over a claim that belongs to someone else.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && name == request.resource.data.username.lower()
        && request.resource.data.keys().hasOnly(['uid', 'username']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- "Want to try" saves (private to each user) ------------------------
    // users/<me>/saved/<postId> - only I can see or change my saved list.
    // (Rules for users/{userId} above do NOT cover subcollections, so the
    //  saved list needs its own rule.)
    match /users/{userId}/saved/{postId} {
      allow read, write: if isMe(userId);
    }

    // --- Blocking (Report & block) -----------------------------------------
    // users/<me>/blocked/<theirId> - my PRIVATE block list; only I see or change it.
    match /users/{userId}/blocked/{otherId} {
      allow read, write: if isMe(userId);
    }

    // --- Reports ------------------------------------------------------------
    // Anyone logged in can SEND a report (as themselves), but nobody can read,
    // change or delete reports from the app - only the owner, in the Console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['reporter_id', 'reported_user_id', 'post_id', 'reason', 'created_at']);
    }

    // --- Friendships (one document per pair of people) ----------------------
    match /friendships/{pairId} {
      // Has either person blocked the other? (Checked when sending a request.)
      function eitherBlocked(members) {
        let a = members[0];
        let b = members[1];
        return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
          || exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
      }

      // You can see a friendship only if you're in it.
      // (resource == null: checking a pair that doesn't exist yet is allowed,
      //  so the app can tell "not friends" apart from "no permission".)
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);

      // Sending a request: must be from YOU, include you, be between exactly
      // two people, start as "pending", and use the correct pair id.
      allow create: if signedIn()
        && request.resource.data.requested_by == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.status == 'pending'
        && !eitherBlocked(request.resource.data.members)
        && (pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
            || pairId == request.resource.data.members[1] + '_' + request.resource.data.members[0]);

      // Accepting: only the person who RECEIVED the request, only from
      // "pending" to "accepted", and nothing else may change.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requested_by
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Either person can remove it (decline, cancel, or unfriend)
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }
  }
}
