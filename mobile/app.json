{
  "expo": {
    "name": "Coffee Dunk",
    "slug": "coffee-dunk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coffeedunk",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.skcoffeedunk.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.skcoffeedunk.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#CBA781",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Coffee Dunk to access your photos so you can post your coffee.",
          "cameraPermission": "Allow Coffee Dunk to use your camera so you can snap your coffee."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Coffee Dunk to use your location to find cafés near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
